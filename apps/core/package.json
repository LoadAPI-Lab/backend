        "@fastify/static": "^10.1.7",
        "@nestjs/common": "^12.2.0",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.2.0",
        "@nestjs/platform-fastify": "^12.2.0",
        "@nestjs/swagger": "^12.0.4",
        "@nestjs/throttler": "^6.7.1",
        "@paralleldrive/cuid2": "^3.3.0",
        "fastify": "^5.12.7",
        "nest-winston": "^2.0.0",
        "nestjs-zod": "^5.5.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "winston": "^3.19.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
