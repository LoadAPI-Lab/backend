        "oxfmt": "^0.71.0",
        "oxlint": "^1.58.0",
        "oxlint-tsgolint": "^7.0.2001",
        "source-map-support": "^0.5.21",
        "supertest": "^7.3.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.2",
        "vitest": "5.0.5"
    }
}
