openapi: 3.0.3
info:
  title: LoadAPI test server
  version: 1.0.0
  description: |
    Predictable target for load tests and scenario demos. No database:
    data lives in memory (at most 100 000 entries per store, oldest evicted)
    and is lost on restart.

    Stall mode (env STALL_EVERY / STALL_FOR) freezes the server at the end of
    every period: requests arriving in the window wait until it ends.
servers:
  - url: http://testserver:8080
    description: From containers in the Docker network (LoadAPI worker)
  - url: http://localhost:8080
    description: From the host machine
tags:
  - name: load
    description: Benchmark targets
  - name: scenario
    description: Demo API for scenarios (login → tasks)
  - name: templating
    description: Demo of body placeholders
  - name: admin
    description: Server statistics, not counted in them

paths:
  /fixed:
    get:
      tags: [load]
      summary: Respond after a fixed delay with a body of a given size
      parameters:
        - name: delay
          in: query
          description: Go duration from 0 to 60s
          schema: { type: string, example: 10ms }
        - name: size
          in: query
          description: Body size in bytes, 0 to 1048576
          schema: { type: integer, minimum: 0, maximum: 1048576, example: 1024 }
      responses:
        "200":
          description: Body of `size` bytes
          content:
            text/plain:
              schema: { type: string }
        "400": { $ref: "#/components/responses/BadParameter" }

  /status/{code}:
    get:
      tags: [load]
      summary: Respond with the given status code and an empty body
      parameters:
        - name: code
          in: path
          required: true
          schema: { type: integer, minimum: 200, maximum: 599, example: 429 }
      responses:
        default:
          description: The requested status code
        "400": { $ref: "#/components/responses/BadParameter" }

  /flaky:
    get:
      tags: [load]
      summary: Respond 500 with probability errorRate, otherwise 200
      parameters:
        - name: errorRate
          in: query
          schema: { type: number, minimum: 0, maximum: 1, example: 0.05 }
        - name: delay
          in: query
          schema: { type: string, example: 10ms }
      responses:
        "200": { description: Success }
        "500": { description: Simulated failure }
        "400": { $ref: "#/components/responses/BadParameter" }

  /auth/login:
    post:
      tags: [scenario]
      summary: Get an access token (any non-empty email and password)
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: "#/components/schemas/LoginRequest" }
            example: { email: demo@example.com, password: secret }
      responses:
        "200":
          description: Token for the Authorization header
          content:
            application/json:
              schema: { $ref: "#/components/schemas/LoginResponse" }
        "400": { $ref: "#/components/responses/BadRequest" }
        "401": { $ref: "#/components/responses/Unauthorized" }

  /tasks:
    post:
      tags: [scenario]
      summary: Create a task
      security: [{ bearerAuth: [] }]
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: "#/components/schemas/CreateTaskRequest" }
            example: { title: "task-{{$uuid}}" }
      responses:
        "201":
          description: Created task
          content:
            application/json:
              schema: { $ref: "#/components/schemas/TaskResponse" }
        "400": { $ref: "#/components/responses/BadRequest" }
        "401": { $ref: "#/components/responses/Unauthorized" }

  /tasks/{id}:
    parameters:
      - name: id
        in: path
        required: true
        schema: { type: integer, example: 1 }
    get:
      tags: [scenario]
      summary: Get a task of the current user
      security: [{ bearerAuth: [] }]
      responses:
        "200":
          description: Task
          content:
            application/json:
              schema: { $ref: "#/components/schemas/TaskResponse" }
        "401": { $ref: "#/components/responses/Unauthorized" }
        "404": { $ref: "#/components/responses/NotFound" }
    patch:
      tags: [scenario]
      summary: Update the title and/or status of a task
      security: [{ bearerAuth: [] }]
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: "#/components/schemas/UpdateTaskRequest" }
            example: { status: done }
      responses:
        "200":
          description: Updated task
          content:
            application/json:
              schema: { $ref: "#/components/schemas/TaskResponse" }
        "400": { $ref: "#/components/responses/BadRequest" }
        "401": { $ref: "#/components/responses/Unauthorized" }
        "404": { $ref: "#/components/responses/NotFound" }
    delete:
      tags: [scenario]
      summary: Delete a task
      security: [{ bearerAuth: [] }]
      responses:
        "204": { description: Deleted }
        "401": { $ref: "#/components/responses/Unauthorized" }
        "404": { $ref: "#/components/responses/NotFound" }

  /users:
    post:
      tags: [templating]
      summary: Register a user; a repeated email gives 409
      requestBody:
